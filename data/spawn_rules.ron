// Data-driven spawn rules loaded at worker start.
//
// Schema: `game_schema::spawn::SpawnFile`.
// Semantics:
//   - `scope` selects which zones the rule applies to.
//     * OpenWorldCell(rx, rz)                       — one open-world cell (layer 0)
//     * OpenWorldAny(rx_min, rx_max, rz_min, rz_max) — inclusive bounding box
//     * Dungeon(template_id)                         — all instances of a template
//   - `trigger` gates activation (WorldPhase / PlayerCountAtLeast).
//   - `cooldown_ticks` = minimum ticks between firings.
//   - `max_activations` = 0 means unlimited; otherwise hard cap.
//   - `scaling` (optional) applies current per-player HP/count multipliers.
//
// Reserved but intentionally not authored here yet:
//   - SpawnTrigger::OnEvent
//   - SpawnScaling::per_level_hp_mult / level_source
//   - SpawnEntityDef::encounter_template
//
// Hot-reload is NOT supported; rules are read once in coordinator startup.

(
    rules: [
        // Origin-area open-world boss spawn proof.
        // Mirrors the hardcoded 3x3 grid previously registered in
        // `coordinator.rs` on_applied. Fires when zone phase flips to
        // "boss_ready" (driven by the 5-kills world_clock rule).
        (
            rule_id: "open_world_origin_boss",
            scope: OpenWorldAny(rx_min: -1, rx_max: 1, rz_min: -1, rz_max: 1),
            trigger: WorldPhase(phase_name: "boss_ready"),
            spawns: [
                (kind: Boss, max_hp: 500.0, offset: (0.0, 1.0, 0.0)),
            ],
            cooldown_ticks: 100,
            max_activations: 1,
        ),

        // Single-cell trash/patrol proof. Fires when at least one player is
        // active in the origin cell and demonstrates per-player scaling.
        (
            rule_id: "open_world_origin_patrol",
            scope: OpenWorldCell(rx: 0, rz: 0),
            trigger: PlayerCountAtLeast(threshold: 1),
            spawns: [
                (kind: Npc, max_hp: 120.0, offset: (8.0, 1.0, 8.0)),
            ],
            cooldown_ticks: 400,
            max_activations: 2,
            scaling: Some((
                per_player_hp_mult: 0.25,
                per_player_count: 0.5,
                per_level_hp_mult: 0.0,
                level_source: None,
            )),
        ),

        // Dungeon-scoped player-count proof. Registered per live instance of
        // `test_dungeon_01` and cleared when that instance expires.
        (
            rule_id: "training_dungeon_reinforcements",
            scope: Dungeon(template_id: "test_dungeon_01"),
            trigger: PlayerCountAtLeast(threshold: 2),
            spawns: [
                (kind: Npc, max_hp: 180.0, offset: (6.0, 1.0, -12.0)),
            ],
            cooldown_ticks: 300,
            max_activations: 1,
            scaling: Some((
                per_player_hp_mult: 0.35,
                per_player_count: 1.0,
                per_level_hp_mult: 0.0,
                level_source: None,
            )),
        ),

    ],
)
