// Data-driven spawn rules loaded at worker start.
//
// Schema: `game_schema::spawn::SpawnFile`.
// Semantics:
//   - `scope` selects which zones the rule applies to.
//     * OpenWorldCell(rx, rz)                       — one open-world cell (layer 0)
//     * OpenWorldAny(rx_min, rx_max, rz_min, rz_max) — inclusive bounding box
//     * Dungeon(template_id)                         — all instances of a template
//   - `trigger` gates activation (WorldPhase / PlayerCountAtLeast).
//   - `cooldown_ticks` = minimum ticks between firings.
//   - `max_activations` = 0 means unlimited; otherwise hard cap.
//   - `scaling` (optional) applies current per-player HP/count multipliers.
//
// Reserved but intentionally not authored here yet:
//   - SpawnTrigger::OnEvent
//   - SpawnScaling::per_level_hp_mult / level_source
//     (Player-level / down-scaling: deferred until a level system lands.
//      See docs/contracts/world_activity_policy_contract.md "Deferred"
//      section. When levels exist, this field activates without code
//      changes; until then, scaling is player-count-only.)
//
// Hot-reload is NOT supported; rules are read once in coordinator startup.

(
    rules: [
        // Origin-area open-world boss spawn proof.
        // Mirrors the hardcoded 3x3 grid previously registered in
        // `coordinator.rs` on_applied. Gated on the `boss_ready`
        // world_activity_event row being Active AND ≥1 active
        // (non-disconnected) player in the cell, so the boss never
        // spawns into an empty region just because world_clock flipped
        // the phase. Closes Finding #4 of the 2026-06-09 messaging
        // review.
        //
        // HP scales modestly per extra player to make a 5-player attempt
        // ~2× as durable as a solo attempt without trivializing the
        // first kill. Spawn count is locked at 1 — for "more enemies
        // when more players show up" use the multi-tier pattern
        // demonstrated by `open_world_origin_boss_reinforcements`
        // below.
        (
            rule_id: "open_world_origin_boss",
            scope: OpenWorldAny(rx_min: -1, rx_max: 1, rz_min: -1, rz_max: 1),
            trigger: WorldActivityEventActive(tag: "boss_ready", min_players: 1),
            spawns: [
                (kind: Boss, max_hp: 500.0, offset: (0.0, 1.0, 0.0)),
            ],
            cooldown_ticks: 100,
            max_activations: 1,
            scaling: Some((
                per_player_hp_mult: 0.25,
                per_player_count: 0.0,
                per_level_hp_mult: 0.0,
                level_source: None,
            )),
        ),

        // Multi-tier escalation: a second rule on the same
        // `boss_ready` event with a higher player-count gate. Fires
        // once when ≥3 players are in the cell, adding scaled
        // reinforcements alongside the boss. The two rules together
        // demonstrate the "small-form Option B" pattern from the
        // 2026-06-09 messaging review: zero new code, pure RON
        // authoring drives "more players → bigger event".
        //
        // Activation matrix (single attempt, max_activations = 1 per rule):
        //   - 1-2 players when event flips Active: boss only (HP 500–625).
        //   - 3 players: boss + 2 minions @ 168 HP each.
        //   - 5 players: boss (HP 1000) + 3 minions @ 240 HP each.
        (
            rule_id: "open_world_origin_boss_reinforcements",
            scope: OpenWorldAny(rx_min: -1, rx_max: 1, rz_min: -1, rz_max: 1),
            trigger: WorldActivityEventActive(tag: "boss_ready", min_players: 3),
            spawns: [
                (kind: Npc, max_hp: 120.0, offset: (3.0, 1.0, 0.0)),
            ],
            cooldown_ticks: 100,
            max_activations: 1,
            scaling: Some((
                per_player_hp_mult: 0.4,
                per_player_count: 0.5,
                per_level_hp_mult: 0.0,
                level_source: None,
            )),
        ),

        // Single-cell trash/patrol proof. Fires when at least one player is
        // active in the origin cell and demonstrates per-player scaling.
        (
            rule_id: "open_world_origin_patrol",
            scope: OpenWorldCell(rx: 0, rz: 0),
            trigger: PlayerCountAtLeast(threshold: 1),
            spawns: [
                (kind: Npc, max_hp: 120.0, offset: (8.0, 1.0, 8.0)),
            ],
            cooldown_ticks: 400,
            max_activations: 2,
            scaling: Some((
                per_player_hp_mult: 0.25,
                per_player_count: 0.5,
                per_level_hp_mult: 0.0,
                level_source: None,
            )),
        ),

        // Dungeon-scoped player-count proof. Registered per live instance of
        // `test_dungeon_01` and cleared when that instance expires.
        (
            rule_id: "training_dungeon_reinforcements",
            scope: Dungeon(template_id: "test_dungeon_01"),
            trigger: PlayerCountAtLeast(threshold: 2),
            spawns: [
                (kind: Npc, max_hp: 180.0, offset: (6.0, 1.0, -12.0)),
            ],
            cooldown_ticks: 300,
            max_activations: 1,
            scaling: Some((
                per_player_hp_mult: 0.35,
                per_player_count: 1.0,
                per_level_hp_mult: 0.0,
                level_source: None,
            )),
        ),

    ],
)
