// Terrain asset manifest.
//
// `terrain_set` is the authoritative name used by data/layers.ron,
// DungeonTemplate.terrain_set, and the SpacetimeDB terrain_set row.
// `server_mesh` is the low-resolution mesh imported into DB chunks for worker
// collision. `client_prediction_mesh` defaults to the server mesh when omitted.
// `client_visual` is the optional high-detail visual stem referenced by
// client_visual in layer/dungeon RON; `visual_mesh` is the CDN/map-bundle entry.
(
    assets: [
        (
            terrain_set: "smoke_floor",
            synthetic: true,
            note: Some("Synthetic dev fixture generated by `cargo xtask dev seed-terrain`."),
        ),
        (
            terrain_set: "hills_terrain",
            server_mesh: Some("assets/terrain/hills_lowpoly/hills_terrain.gltf"),
            client_prediction_mesh: Some("assets/terrain/hills_lowpoly/hills_terrain.gltf"),
            client_visual: Some("hills_highpoly"),
            visual_mesh: Some("assets/terrain/hills_highpoly/hills_highpoly.gltf"),
        ),
        (
            terrain_set: "biome_terrain",
            server_mesh: Some("assets/terrain/biome_terrain/biome_terrain.gltf"),
            client_prediction_mesh: Some("assets/terrain/biome_terrain/biome_terrain.gltf"),
            visual_mesh: Some("assets/terrain/biome_terrain/biome_terrain.gltf"),
        ),
    ],
)
