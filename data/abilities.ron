    timelines: [
        (
            ability_id: 1,
            actions: [
                // tick 0: spawn hitbox + start 1-second cooldown simultaneously
                (tick_offset: 0, action: SpawnHitbox(shape: CapsuleSweep, offset: (x: 0.0, y: 0.0, z: 0.0))),
                (tick_offset: 0, action: CooldownStart(duration_ticks: 20)),
                // tick 1: damage frame — contacts this tick deal damage
                (tick_offset: 1, action: ApplyDamageFrame),
                // tick 2: hitbox gone, open 10-tick combo window → press again for Slash Combo (id 4)
                (tick_offset: 2, action: RemoveHitbox),
                (tick_offset: 2, action: OpenFollowUpWindow(duration_ticks: 10, next_ability_id: 4)),
            ],
        ),
        (
            ability_id: 2,
            actions: [
                // Fireball: spawn projectile, arm it immediately, and let it travel
                // until it hits something or exceeds max range (auto-removed by
