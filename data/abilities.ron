                (tick_offset: 0, action: SpawnConfiguredHitbox(
                    shape: Projectile,
                    offset: (x: 0.0, y: 1.0, z: 0.0),
                    effect: None,
                    rules: Some((pierce: true)),
                )),
                (tick_offset: 0, action: CooldownStart(duration_ticks: 40)),
                (tick_offset: 0, action: ApplyDamageFrame),
            ],
