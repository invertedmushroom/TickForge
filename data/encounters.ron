// Encounter scripts (Step 2 + Step 3 shape).
//
// Each encounter is referenced by `name` from a Boss spawn's `encounter_name`
// (see data/dungeons.ron). Rules are `(id, when, cond, effects, repeat)`.
//
// Step 3 surface (now wired):
//   - Triggers: OnEvent / OnEntityDied / OnMechanicEnded fan in via the
//     EncounterBus drained at the start of each evaluate().
//   - Effects: Sequence { steps: [...] } parks its tail at the first Wait;
//     Parallel { steps: [...] } applies in order this tick. Wait outside a
//     Sequence is a no-op.
//   - VolumeAnchor::FollowBoss tracks the boss every tick.
//   - Effect::Telegraph emits a real EventPayload::TelegraphWarning event.
//
// Built-in mechanic names:
//   "marker" (placeholder; auto-finishes one tick after start)
//   "timed_volume_pulse" (spawns tagged volumes and emits authored pulse events)
//
// Built-in archetype names (data/spawn_rules.ron-adjacent worker registry):
//   "trash" / "elite" — see crates/simulation_worker/src/tick_pipeline/archetype.rs
(
    encounters: [
        // Default rules for any Boss whose `encounter_name` is unset or
        // unresolved.
        (
            name: "default",
            rules: [
                (
                    id: "phase2_at_50",
                    when: OnHpBelow(percent: 0.5),
                    cond: Always,
                    effects: [ChangePhase(phase: Phase2)],
                    repeat: Once,
                ),
                (
                    id: "enrage_at_20",
                    when: OnHpBelow(percent: 0.2),
                    cond: Always,
                    effects: [ChangePhase(phase: Enrage)],
                    repeat: Once,
                ),
                (
                    id: "phase3_after_60s",
                    when: OnAfter(ticks: 1200),
                    cond: Always,
                    effects: [ChangePhase(phase: Phase3)],
                    repeat: Once,
                ),
            ],
        ),
        // Demonstrates OnEnter triggering on a phase that isn't entered until
        // another rule fires ChangePhase first.
        (
            name: "state_enter_demo",
            rules: [
                (
                    id: "enter_p2_via_hp",
                    when: OnHpBelow(percent: 0.5),
                    cond: Always,
                    effects: [ChangePhase(phase: Phase2)],
                    repeat: Once,
                ),
                (
                    id: "p2_to_p3_on_entry",
                    when: OnEnter(phase: Phase2),
                    cond: Always,
                    effects: [ChangePhase(phase: Phase3)],
                    repeat: Once,
                ),
            ],
        ),
        // Sandbox encounter that exercises the core runtime action surface.
        // Used by data-driven smoke tests.
        (
            name: "runtime_actions_demo",
            rules: [
                (
                    id: "start_marker",
                    when: OnAfter(ticks: 35),
                    cond: Always,
                    effects: [StartMechanic(name: "marker", params: ())],
                    repeat: Once,
                ),
                (
                    id: "spawn_adds",
                    when: OnAfter(ticks: 55),
                    cond: Always,
                    effects: [SpawnAdds(archetype: "trash", count: 4, tags: [])],
                    repeat: Once,
                ),
                (
                    id: "swap_kit",
                    when: OnAfter(ticks: 65),
                    cond: Always,
                    effects: [ReplaceAbilityList(ability_ids: [124, 125])],
                    repeat: Once,
                ),
                (
                    id: "telegraph_then_cast",
                    when: OnAfter(ticks: 70),
                    cond: Always,
                    effects: [
                        Telegraph(skill_id: 124, target: TopThreat, lead_ticks: 40),
                        CastSkill(skill_id: 124, target: TopThreat),
                    ],
                    repeat: Once,
                ),
                // Counter feedback example: a real fight would often bump this
                // from an OnEntityDied rule; here we demonstrate the Effect
                // leaf and the OnCounter trigger directly.
                (
                    id: "bump_counter",
                    when: OnAfter(ticks: 25),
                    cond: Always,
                    effects: [IncrementCounter(name: "demo_counter", delta: 4)],
                    repeat: Once,
                ),
                (
                    id: "phase3_at_4_kills",
                    when: OnCounter(name: "demo_counter", op: Ge, value: 4),
                    cond: Always,
                    effects: [ChangePhase(phase: Phase3)],
                    repeat: Once,
                ),
            ],
        ),
        // ── First real fight ────────────────────────────────────
        //
        // The Crucible Warden is the integration acceptance test for the
        // Encounter runtime surface. It exercises the primitive set end
        // to end:
        //
        //   • Phase 1 — FollowBoss aura volume (`warden_aura`) tracks the
        //     boss; periodic Sequence{Telegraph → Wait → CastSkill} pattern.
        //   • Phase 2 — Spawns 4 adds; OnEntityDied{tag="warden_minion"}
        //     counts kills. OnCounter(Ge 4) advances to Phase 3 and starts
        //     a marker mechanic.
        //   • Phase 3 — OnMechanicEnded{name="marker"} fires the transition
        //     Sequence and emits a Custom event the rules subscribe to.
        //   • Enrage — HP 0.2 swaps the ability list and pulses an event
        //     every 20 ticks; OnEvent reacts with a CastSkill.
        //
        // Skill ids: 124 (Warden Fire Patch), 125 (Warden Lava Pool).
        //
        // Add tagging for OnEntityDied is wired by the worker when
        // `apply_spawn_adds` runs through the SpawnAdds output: every
        // scripted add picks up its archetype name as a tag and is
        // auto-registered against the boss's encounter via
        // `register_encounter_add`. The encounter author tags adds via
        // the archetype name they request.
        (
            name: "crucible_warden",
            loot_table_id: Some("warden_boss_drops"),
            rules: [
                // ── Phase 1 ─────────────────────────────────────
                (
                    id: "p1_aura",
                    when: OnEnter(phase: Phase1),
                    cond: Always,
                    effects: [
                        SpawnVolume(
                            tag: "warden_aura",
                            shape: Sphere(radius: 4.0),
                            anchor: FollowBoss,
                            lifetime_ticks: None,
                            entity_filter: ExcludeOwner,
                        ),
                    ],
                    repeat: Once,
                ),
                (
                    id: "p1_telegraph_pattern",
                    when: OnEvery(ticks: 180),
                    cond: PhaseIs(phase: Phase1),
                    effects: [
                        Sequence(steps: [
                            Telegraph(skill_id: 124, target: TopThreat, lead_ticks: 20),
                            Wait(ticks: 20),
                            CastSkill(skill_id: 124, target: TopThreat),
                        ]),
                    ],
                    repeat: EveryNTicks(interval: 180, max_fires: None),
                ),
                (
                    id: "p1_to_p2_at_60",
                    when: OnHpBelow(percent: 0.6),
                    cond: Always,
                    effects: [ChangePhase(phase: Phase2)],
                    repeat: Once,
                ),
                // ── Phase 2 ─────────────────────────────────────
                (
                    id: "p2_summon_minions",
                    when: OnEnter(phase: Phase2),
                    cond: Always,
                    effects: [
                        EmitEncounterEvent(name: "summon_begin"),
                        SpawnAdds(archetype: "warden_minion", count: 4, tags: ["warden_minion"]),
                    ],
                    repeat: Once,
                ),
                (
                    id: "p2_count_minion_deaths",
                    when: OnEntityDied(tag: "warden_minion"),
                    cond: PhaseIs(phase: Phase2),
                    effects: [IncrementCounter(name: "minions_slain", delta: 1)],
                    repeat: EveryNTicks(interval: 1, max_fires: None),
                ),
                (
                    id: "p2_to_p3_on_clear",
                    when: OnCounter(name: "minions_slain", op: Ge, value: 4),
                    cond: PhaseIs(phase: Phase2),
                    effects: [
                        ChangePhase(phase: Phase3),
                        StartMechanic(name: "marker", params: ()),
                    ],
                    repeat: Once,
                ),
                // ── Phase 3 ─────────────────────────────────────
                //
                // The marker mechanic auto-finishes one tick after start.
                // OnMechanicEnded fires on the tick after that, kicking off
                // the transition Sequence: telegraph the AoE, wait 30 ticks,
                // then both fire the cast and emit a Custom event the
                // bookkeeping rule below subscribes to.
                (
                    id: "p3_transition_sequence",
                    when: OnMechanicEnded(name: "marker"),
                    cond: PhaseIs(phase: Phase3),
                    effects: [
                        Sequence(steps: [
                            Telegraph(skill_id: 125, target: AllPlayers, lead_ticks: 30),
                            Wait(ticks: 30),
                            Parallel(steps: [
                                CastSkill(skill_id: 125, target: TopThreat),
                                EmitEncounterEvent(name: "p3_transition_done"),
                            ]),
                        ]),
                    ],
                    repeat: Once,
                ),
                (
                    id: "p3_log_transition",
                    when: OnEvent(event_name: "p3_transition_done"),
                    cond: Always,
                    effects: [IncrementCounter(name: "transitions", delta: 1)],
                    repeat: Once,
                ),
                // ── Enrage ──────────────────────────────────────
                (
                    id: "enrage_at_20",
                    when: OnHpBelow(percent: 0.2),
                    cond: Always,
                    effects: [
                        ChangePhase(phase: Enrage),
                        ReplaceAbilityList(ability_ids: [124, 125]),
                        DespawnVolume(tag: "warden_aura"),
                    ],
                    repeat: Once,
                ),
                (
                    id: "enrage_pulse",
                    when: OnEvery(ticks: 20),
                    cond: PhaseIs(phase: Enrage),
                    effects: [EmitEncounterEvent(name: "enrage_pulse")],
                    repeat: EveryNTicks(interval: 20, max_fires: None),
                ),
                (
                    id: "enrage_react",
                    when: OnEvent(event_name: "enrage_pulse"),
                    cond: PhaseIs(phase: Enrage),
                    effects: [CastSkill(skill_id: 124, target: TopThreat)],
                    repeat: EveryNTicks(interval: 20, max_fires: None),
                ),
            ],
        ),
        // ── Manaya's Core composition example ──────────────────
        //
        // `timed_volume_pulse` owns only the arena + distance-band volumes
        // and emits pulse events. Rules below own the boss lock, cue timing,
        // mark assignment, strict swap validation, failure emission, cleanup,
        // and wipe composition.
        //
        // This demo is tuned for 3 players: one in near, one in mid, one in
        // far. A solo smoke run should fail the placement rule and enter the
        // authored wipe path.
        (
            name: "manayas_core_demo",
            rules: [
                (
                    id: "trigger_core_phase",
                    when: OnHpBelow(percent: 0.95),
                    cond: PhaseIs(phase: Phase1),
                    effects: [ChangePhase(phase: Phase2)],
                    repeat: Once,
                ),
                (
                    id: "start_core",
                    when: OnEvery(ticks: 600),
                    cond: PhaseIs(phase: Phase2),
                    effects: [
                        // Lock the boss and show the rings before the pulse.
                        // `initial_delay_ticks` below is the positioning
                        // window; the pulse itself is the resolution point.
                        ApplyBuff(
                            target: Boss,
                            buff_id: 802,
                            mode: ReplaceAny([802]),
                        ),
                        EncounterCue(
                            target: Boss,
                            cue_id: "manaya_core_near_ring",
                            anchor: Boss,
                            shape: Ring(inner_radius: 0.0, outer_radius: 5.0, half_height: 3.0),
                            duration_ticks: 120,
                        ),
                        EncounterCue(
                            target: Boss,
                            cue_id: "manaya_core_mid_ring",
                            anchor: Boss,
                            shape: Ring(inner_radius: 5.0, outer_radius: 10.0, half_height: 3.0),
                            duration_ticks: 120,
                        ),
                        EncounterCue(
                            target: Boss,
                            cue_id: "manaya_core_far_ring",
                            anchor: Boss,
                            shape: Ring(inner_radius: 10.0, outer_radius: 15.0, half_height: 3.0),
                            duration_ticks: 120,
                        ),
                        StartMechanic(
                            name: "timed_volume_pulse",
                            params: (
                                ints: {
                                    "initial_delay_ticks": 120,
                                    "pulse_interval_ticks": 120,
                                },
                                strings: {
                                    "first_pulse_event": "core_pulse",
                                    "pulse_event": "core_pulse",
                                },
                                zones: [
                                    (
                                        tag: "manaya_core_arena",
                                        shape: Sphere(radius: 18.0),
                                        anchor: FollowBoss,
                                        priority: 0,
                                        lifetime_ticks: None,
                                    ),
                                    (
                                        tag: "manaya_core_near",
                                        shape: Ring(inner_radius: 0.0, outer_radius: 5.0, half_height: 3.0),
                                        anchor: FollowBoss,
                                        priority: 10,
                                        lifetime_ticks: None,
                                    ),
                                    (
                                        tag: "manaya_core_mid",
                                        shape: Ring(inner_radius: 5.0, outer_radius: 10.0, half_height: 3.0),
                                        anchor: FollowBoss,
                                        priority: 20,
                                        lifetime_ticks: None,
                                    ),
                                    (
                                        tag: "manaya_core_far",
                                        shape: Ring(inner_radius: 10.0, outer_radius: 15.0, half_height: 3.0),
                                        anchor: FollowBoss,
                                        priority: 30,
                                        lifetime_ticks: None,
                                    ),
                                ],
                            ),
                        ),
                    ],
                    repeat: EveryNTicks(interval: 600, max_fires: None),
                ),
                (
                    id: "core_pulse_cleanup",
                    when: OnEvent(event_name: "core_pulse"),
                    cond: Always,
                    effects: [
                        // The shipped demo uses one pulse per core window.
                        // Remove this stop rule for continuous pulses driven
                        // by `pulse_interval_ticks`.
                        StopMechanic(name: "timed_volume_pulse"),
                        RemoveBuffs(target: Boss, buff_ids: [802], force: true),
                    ],
                    repeat: EveryNTicks(interval: 1, max_fires: None),
                ),
                (
                    id: "core_swap_failed",
                    when: OnEvent(event_name: "core_pulse"),
                    cond: Not(cond: Any(conds: [
                        All(conds: [
                            CounterCmp(name: "core_mechanic_count", op: Eq, value: 0),
                            OccupancyCmp(tag: "manaya_core_near", op: Eq, count: 1),
                            OccupancyCmp(tag: "manaya_core_mid", op: Eq, count: 1),
                            OccupancyCmp(tag: "manaya_core_far", op: Eq, count: 1),
                            VolumeOccupantsExactlyOneOf(
                                source_tag: "manaya_core_arena",
                                member_tags: ["manaya_core_near", "manaya_core_mid", "manaya_core_far"],
                            ),
                        ]),
                        All(conds: [
                            CounterCmp(name: "core_mechanic_count", op: Ge, value: 1),
                            OccupancyCmp(tag: "manaya_core_near", op: Eq, count: 1),
                            OccupancyCmp(tag: "manaya_core_mid", op: Eq, count: 1),
                            OccupancyCmp(tag: "manaya_core_far", op: Eq, count: 1),
                            VolumeOccupantsExactlyOneOf(
                                source_tag: "manaya_core_arena",
                                member_tags: ["manaya_core_near", "manaya_core_mid", "manaya_core_far"],
                            ),
                            Any(conds: [
                                AllVolumeOccupantsHaveBuff(tag: "manaya_core_near", buff_id: 803),
                                AllVolumeOccupantsHaveBuff(tag: "manaya_core_near", buff_id: 801),
                            ]),
                            Any(conds: [
                                AllVolumeOccupantsHaveBuff(tag: "manaya_core_mid", buff_id: 800),
                                AllVolumeOccupantsHaveBuff(tag: "manaya_core_mid", buff_id: 801),
                            ]),
                            Any(conds: [
                                AllVolumeOccupantsHaveBuff(tag: "manaya_core_far", buff_id: 800),
                                AllVolumeOccupantsHaveBuff(tag: "manaya_core_far", buff_id: 803),
                            ]),
                        ]),
                    ])),
                    effects: [EmitEncounterEvent(name: "manaya_core_failed")],
                    repeat: EveryNTicks(interval: 1, max_fires: None),
                ),
                (
                    id: "core_first_application",
                    when: OnEvent(event_name: "core_pulse"),
                    cond: All(conds: [
                        CounterCmp(name: "core_mechanic_count", op: Eq, value: 0),
                        OccupancyCmp(tag: "manaya_core_near", op: Eq, count: 1),
                        OccupancyCmp(tag: "manaya_core_mid", op: Eq, count: 1),
                        OccupancyCmp(tag: "manaya_core_far", op: Eq, count: 1),
                        VolumeOccupantsExactlyOneOf(
                            source_tag: "manaya_core_arena",
                            member_tags: ["manaya_core_near", "manaya_core_mid", "manaya_core_far"],
                        ),
                    ]),
                    effects: [
                        ApplyBuff(
                            target: VolumeOccupants(tag: "manaya_core_near"),
                            buff_id: 800,
                            mode: ReplaceAny([800, 801, 803]),
                        ),
                        ApplyBuff(
                            target: VolumeOccupants(tag: "manaya_core_mid"),
                            buff_id: 803,
                            mode: ReplaceAny([800, 801, 803]),
                        ),
                        ApplyBuff(
                            target: VolumeOccupants(tag: "manaya_core_far"),
                            buff_id: 801,
                            mode: ReplaceAny([800, 801, 803]),
                        ),
                        IncrementCounter(name: "core_mechanic_count", delta: 1),
                    ],
                    repeat: EveryNTicks(interval: 1, max_fires: None),
                ),
                (
                    id: "core_swap_success",
                    when: OnEvent(event_name: "core_pulse"),
                    cond: All(conds: [
                        CounterCmp(name: "core_mechanic_count", op: Ge, value: 1),
                        OccupancyCmp(tag: "manaya_core_near", op: Eq, count: 1),
                        OccupancyCmp(tag: "manaya_core_mid", op: Eq, count: 1),
                        OccupancyCmp(tag: "manaya_core_far", op: Eq, count: 1),
                        VolumeOccupantsExactlyOneOf(
                            source_tag: "manaya_core_arena",
                            member_tags: ["manaya_core_near", "manaya_core_mid", "manaya_core_far"],
                        ),
                        Any(conds: [
                            AllVolumeOccupantsHaveBuff(tag: "manaya_core_near", buff_id: 803),
                            AllVolumeOccupantsHaveBuff(tag: "manaya_core_near", buff_id: 801),
                        ]),
                        Any(conds: [
                            AllVolumeOccupantsHaveBuff(tag: "manaya_core_mid", buff_id: 800),
                            AllVolumeOccupantsHaveBuff(tag: "manaya_core_mid", buff_id: 801),
                        ]),
                        Any(conds: [
                            AllVolumeOccupantsHaveBuff(tag: "manaya_core_far", buff_id: 800),
                            AllVolumeOccupantsHaveBuff(tag: "manaya_core_far", buff_id: 803),
                        ]),
                    ]),
                    effects: [
                        ApplyBuff(
                            target: VolumeOccupants(tag: "manaya_core_near"),
                            buff_id: 800,
                            mode: ReplaceAny([800, 801, 803]),
                        ),
                        ApplyBuff(
                            target: VolumeOccupants(tag: "manaya_core_mid"),
                            buff_id: 803,
                            mode: ReplaceAny([800, 801, 803]),
                        ),
                        ApplyBuff(
                            target: VolumeOccupants(tag: "manaya_core_far"),
                            buff_id: 801,
                            mode: ReplaceAny([800, 801, 803]),
                        ),
                        IncrementCounter(name: "core_mechanic_count", delta: 1),
                    ],
                    repeat: EveryNTicks(interval: 1, max_fires: None),
                ),
                (
                    id: "core_failed_wipe",
                    when: OnEvent(event_name: "manaya_core_failed"),
                    cond: Always,
                    effects: [
                        ChangePhase(phase: Custom("Wipe")),
                        RemoveBuffs(target: AllPlayers, buff_ids: [800, 801, 803], force: true),
                        EncounterCue(
                            target: Boss,
                            cue_id: "manaya_core_failed",
                            anchor: Boss,
                            shape: Ring(inner_radius: 0.0, outer_radius: 15.0, half_height: 3.0),
                            duration_ticks: 30,
                        ),
                        Sequence(steps: [
                            Telegraph(skill_id: 125, target: AllPlayers, lead_ticks: 30),
                            Wait(ticks: 30),
                            CastSkill(skill_id: 125, target: AllPlayers),
                            RemoveBuffs(target: Boss, buff_ids: [802], force: true),
                        ]),
                    ],
                    repeat: Once,
                ),
            ],
        ),
    ],
)
